+#if defined(ARM64_BOARD_CONFIG_B2L)
+/*
+ * B2L: SCTLR_EL1.UCI is clear on this board (proc_reg.h), so EL0 cache maintenance by VA traps here.
+ * iOS's sys_icache_invalidate (libsystem_platform, the only EL0 cache maintenance in the whole 23G90 cache) runs
+ * IC IVAU without a DC CVAU first: enough on Apple cores (CTR_EL0.IDC=1), not on the Exynos 9820, where freshly
+ * written JIT code then ran stale (WebKit: 262 "undefined instruction" deaths on valid words, B1L-0202..0213).
+ * Each trapped line is done here by its user address: D-cache clean to PoU, then I-cache invalidate. An address EL0
+ * cannot read has nothing to maintain.
+ */
+#define B2L_CACHE_LINE 64ULL
+static bool
+b2l_user_cache_op(arm_saved_state_t *state, uint64_t esr)
+{
+	uint32_t iss = (uint32_t)ESR_ISS(esr);
+	unsigned op0 = (iss >> 20) & 3, op2 = (iss >> 17) & 7, op1 = (iss >> 14) & 7;
+	unsigned crn = (iss >> 10) & 15, rt = (iss >> 5) & 31, crm = (iss >> 1) & 15;
+	/* SYS #3, C7, Cm, #1: IC IVAU (C5), DC CVAC (C10), DC CVAU (C11), DC CVAP (C12), DC CIVAC (C14) */
+	if (op0 != 1 || op1 != 3 || crn != 7 || op2 != 1 || (iss & 1) ||
+	    (crm != 5 && crm != 10 && crm != 11 && crm != 12 && crm != 14)) {
+		return false;
+	}
+	uint64_t va = rt == 31 ? 0 : get_saved_state_reg(state, rt);
+	va &= 0x00ffffffffffffffULL & ~(B2L_CACHE_LINE - 1);   /* EL0 top-byte tag */
+	uint64_t par = 1;
+	b2l_wk_trace(crm == 5 ? "ic" : "dc", crm, va, 0);   /* B1L-0220 */
+	if (va < MACH_VM_MAX_ADDRESS) {
+		/* B1L-0222: the line is maintained by its user address (TTBR0 is still the thread's), after AT S1E0R says
+		 * EL0 can read it; PAN does not apply to DC/IC by address. The copy window (0219) and phystokv() (0218) both
+		 * froze the phone on WebKit's first IC IVAU. Interrupts are off so PAR_EL1 and the check stay ours.
+		 * shortcut: another thread unmapping the line between the check and the op would fault in the kernel. */
+		boolean_t istate = ml_set_interrupts_enabled(FALSE);
+		__asm__ volatile ("at s1e0r, %1\n isb\n mrs %0, par_el1" : "=r"(par) : "r"(va) : "memory");
+		if (!(par & 1)) {
+			if (crm == 5) {
+				__asm__ volatile ("dc cvau, %0\n dsb ish\n ic ivau, %0\n dsb ish\n isb" : : "r"(va) : "memory");
+			} else if (crm == 11) {
+				__asm__ volatile ("dc cvau, %0\n dsb ish" : : "r"(va) : "memory");
+			} else {
+				__asm__ volatile ("dc civac, %0\n dsb ish" : : "r"(va) : "memory");
+			}
+		}
+		ml_set_interrupts_enabled(istate);
+	}
+	b2l_wk_trace("done", crm, va, par);   /* B1L-0222 */
+	add_saved_state_pc(state, 4);
+	return true;
+}
+#endif
